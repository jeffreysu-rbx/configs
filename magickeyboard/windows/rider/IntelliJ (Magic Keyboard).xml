<keymap version="1" name="IntelliJ (Magic Keyboard)" parent="$default">
  <action id="EditorCreateRectangularSelectionOnMouseDrag">
    <mouse-shortcut keystroke="button2" />
  </action>
  <action id="GotoDeclaration">
    <keyboard-shortcut first-keystroke="ctrl b" />
    <mouse-shortcut keystroke="control button1" />
    <mouse-shortcut keystroke="alt button1" />
  </action>
  <action id="GotoLine">
    <keyboard-shortcut first-keystroke="ctrl g" />
    <keyboard-shortcut first-keystroke="alt l" />
  </action>
  <action id="QuickEvaluateExpression">
    <keyboard-shortcut first-keystroke="ctrl alt f8" />
  </action>
</keymap>
